 @page "/login"
 @layout AuthLayout

@inject AuthenticationServieces servieces
@inject NavigationManager navigationManager
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage

@if (flag)
{
    navigationManager.NavigateTo("/ByteBankHome");
}
else
{
    <div class="@($"login-page {(isDark ? "dark" : "")}")">

        <!-- LEFT SIDE -->
        <div class="login-left">
            <h1>Welcome to ByteBank 👋</h1>
            <p>
                Secure banking platform to manage your cards and transactions easily.
            </p>

            <button class="theme-btn" @onclick="ToggleTheme">
                @(isDark ? "☀ Light Mode" : "🌙 Dark Mode")
            </button>
        </div>

        <!-- RIGHT SIDE -->
        <div class="login-right">

            <div class="login-card">

                <h3>Login</h3>
               @if (result?.Errors != null)
                        {
                            <div class="toast-error">
                                @foreach (var error in result.Errors)
                                {
                                    <div>⚠ @error.Key</div>
                                    @foreach (var msg in error.Value)
                                    {
                                        <div>⚠ @msg</div>
                                    }
                                }
                            </div>
                        }  

                <EditForm OnValidSubmit="Print" Model="login">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label>Email</label>
                        <InputText @bind-Value="login.Email" class="form-control" />
                        <ValidationMessage For="()=>login.Email"></ValidationMessage>
                    </div>

                    <div class="mb-3">
                        <label>Password</label>
                        <InputText @bind-Value="login.Password" type="password" class="form-control" />
                        <ValidationMessage For="()=>login.Password"></ValidationMessage>

                    </div>

                    <!-- Remember + Forgot -->
                    <div class="options">
                        <label>
                            <input type="checkbox" @bind="rememberMe" />
                            Remember me
                        </label>

                        <a href="#" @onclick="ForgotPassword">Forgot password?</a>
                    </div>

                    <button class="btn-login" disabled="@loading">
                        @if (loading)
                        {
                            <span>Loading...</span>
                        }
                        else
                        {
                            <span>Login</span>
                        }
                    </button>

                </EditForm>

            </div>

        </div>


    </div>
}

@code {

    public UserDto user { get; set; }
    public ApiResult< UserDto> result { get; set; }

    public LoginDto login { get; set; } = new();
    public string errorMessage;
    public bool flag = false;

    public bool loading = false;
    public bool rememberMe = false;
    public bool isDark = false;

    async Task Print()
    {
         try
    {
        loading = true;
        errorMessage = null;

        result = await servieces.LoginServices(login);

        if (result?.IsSuccess == true && result.Data != null)
        {
            await sessionStorage.SetItemAsync("Token", result.Data.Token);
             navigationManager.NavigateTo("/ByteBankHome");
        }
    }
    finally
    {
        loading = false;
    }


    }

    void ToggleTheme()
    {
        isDark = !isDark;
    }

    void ForgotPassword()
    {
        errorMessage = "Reset link feature coming soon 🔐";
    }
}


                <style>

/* ===== PAGE ===== */
.login-page {
    height: 100vh;
    display: flex;
    font-family: 'Segoe UI', sans-serif;
    transition: 0.3s;
}

/* ===== DARK MODE ===== */
.login-page.dark {
    background: #0f172a;
    color: white;
}

/* ===== LEFT SIDE ===== */
.login-left {
    flex: 1;
    background: linear-gradient(135deg, #2563eb, #1e40af);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px;
}

.login-left h1 {
    font-size: 42px;
    font-weight: bold;
}

.login-left p {
    margin-top: 15px;
    opacity: 0.9;
    max-width: 420px;
}

/* ===== RIGHT SIDE ===== */
.login-right {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #f5f7fb;
}

/* DARK RIGHT */
.login-page.dark .login-right {
    background: #0f172a;
}

/* ===== CARD ===== */
.login-card {
    width: 370px;
    background: white;
    padding: 35px;
    border-radius: 18px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
    transition: 0.3s;
}

.login-page.dark .login-card {
    background: #1e293b;
    color: white;
}

/* ===== INPUTS ===== */
.form-control {
    border-radius: 10px;
    padding: 10px;
}

/* focus effect */
.form-control:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37,99,235,0.2);
}

/* ===== BUTTON ===== */
.btn-login {
    width: 100%;
    background: linear-gradient(90deg, #2563eb, #1d4ed8);
    border: none;
    color: white;
    padding: 10px;
    border-radius: 10px;
    font-weight: bold;
    margin-top: 10px;
    transition: 0.3s;
}

.btn-login:hover {
    transform: scale(1.03);
}

/* ===== OPTIONS ===== */
.options {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 10px;
}

/* ===== ERROR ===== */
.error {
    background: #fee2e2;
    color: #991b1b;
    padding: 8px;
    border-radius: 8px;
    margin-bottom: 10px;
}

/* ===== THEME BUTTON ===== */
.theme-btn {
    margin-top: 20px;
    padding: 8px 12px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    background: white;
    color: #1e40af;
}

/* ===== ANIMATION ===== */
.login-left h1 {
    animation: fadeIn 1s ease;
}

.login-card {
    animation: slideUp 0.6s ease;
}

/* ===== ANIMATIONS ===== */
@@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

@@keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}


 .toast-error {
        margin-top: 10px;
        background: #fee2e2;
        color: #991b1b;
        padding: 10px 15px;
        border-radius: 12px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        animation: slideUp 0.3s ease;
        font-size: 14px;
    }

</style>