@if (resultCreateCard?.bank == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container d-flex justify-content-center align-items-center" style="height: 80vh;">
        <div class="card shadow-lg p-4 text-white"
             style="width: 400px; border-radius: 15px; background: linear-gradient(135deg, #4e73df, #1cc88a);">

            <h4 class="mb-4">@resultCreateCard.Name</h4>

            <h5 class="mb-3">@resultCreateCard.bank.Name</h5>

            <div class="mt-3 d-flex justify-content-between">
                <span>CardNumber</span>
                <span>@resultCreateCard.Id</span>
            </div>

            <div class="d-flex justify-content-between">
                <span>Balance</span>
                <span>@resultCreateCard.Amount</span>
            </div>

            <div class="mt-3 d-flex justify-content-between">
                <span>Expire</span>
                <span>@resultCreateCard.ExpireDate</span>
            </div>
            
            

        </div>
    </div>
}
@code {
    [Parameter]
    public ResultCreateCardDto resultCreateCard { get; set; }
}
