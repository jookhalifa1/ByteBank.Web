@page "/GetCard"
@inject CardBankServices services

@if(card is not null)
{
    <div class="container d-flex justify-content-center align-items-center" style="height: 80vh;">
        <div class="card shadow-lg p-4 text-white"
             style="width: 400px; border-radius: 15px; background: linear-gradient(135deg, #4e73df, #1cc88a);">

             
            <h4 class="mb-4">@card.Name</h4>
            
            <h5 class="mb-3">@card.bank.Name</h5>


            <div class="d-flex justify-content-between">
                <span>CardNumber</span>
                <span>@card.Id</span>
            </div>
          
            <div class="d-flex justify-content-between">
                <span>Balance</span>
                <span>@card.Amount</span>
            </div>

            <div class="mt-3 d-flex justify-content-between">
                <span>Expire</span>
                <span>@card.ExpireDate</span>
            </div>

        </div>
    </div>
}
@if (result?.Errors != null)
{
    foreach (var error in result.Errors)
    {
        <div class="text-danger">
            <b>@error.Key</b>

            @foreach (var msg in error.Value)
            {
                <div>- @msg</div>
            }
        </div>
    }
}
@code {



    public string id { get; set; }

    public  ResultCreateCardDto? card { get; set; }
    public ApiResult<ResultCreateCardDto>? result { get; set; }
    

    protected override async Task OnParametersSetAsync()
    {

           id = await sessionStorage.GetItemAsync<string>("cardId");

            result= await services.GetById(id);
            if (result.IsSuccess)
            {
                card = result.Data;
            }

        
      



     }

}
